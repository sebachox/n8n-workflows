      "name": "Convertir a csv"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const raw = item.json.response;\n  let data;\n  try {\n    data = JSON.parse(raw);\n  } catch (e) {\n    const clean = raw.replace(/```json|```/g, '').trim();\n    data = JSON.parse(clean);\n  }\n\n  // Normaliza las llaves a minúscula por si el modelo cambia el casing\n  const normalized = {};\n  for (const key in data) {\n    normalized[key.toLowerCase()] = data[key];\n  }\n\n  results.push({\n    json: {\n      proveedor: normalized.proveedor ?? null,\n      nit: normalized.nit ?? null,\n      fecha: normalized.fecha ?? null,\n      total: normalized.total ?? null\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        224
      ],
      "id": "be5c2678-971b-4d9f-adc0-d63c7e90fa78",
      "name": "Normalizar JSON",
      "alwaysOutputData": false,
      "retryOnFail": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"llama3.2:3b\",\n  format: \"json\",\n  stream: false,\n  prompt: \"Eres un sistema de extraccion de datos contables. Tu unica salida debe ser un objeto JSON valido, sin texto adicional, sin explicaciones. Extrae estos 4 campos de la factura: proveedor (string), nit (string), fecha (string formato YYYY-MM-DD), total (numero sin simbolos ni comas). Si un dato no aparece usa null. Responde solo con el JSON. Texto de la factura: \" + $json.text\n}) }}",
        "options": {}
      },
